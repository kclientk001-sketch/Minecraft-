{
  "name": "minecraft-network",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/select-db.mjs && prisma generate && next build --webpack",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/select-db.mjs && node scripts/init-db.mjs && prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:setup": "node scripts/select-db.mjs && node scripts/init-db.mjs && prisma generate && prisma migrate deploy && node --import tsx prisma/seed.ts",
    "admin:create": "node --import tsx scripts/create-admin.ts",
    "db:postgres:generate": "prisma generate --schema prisma/schema.postgres.prisma",
    "build:inet": "node --import tsx scripts/build-inet.ts",
    "test:e2e:serve": "node scripts/e2e-server.mjs",
    "db:use-postgres": "node scripts/select-db.mjs postgres",
    "test:inet": "playwright test --config playwright.inet.config.ts",
    "preview:inet": "node scripts/preview-inet.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "next": "16.4.2",
    "prisma": "6.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.65.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.3.6",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "effect": "^3.20.0"
  }
}
