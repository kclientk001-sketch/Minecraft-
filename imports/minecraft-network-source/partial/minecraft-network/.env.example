# Copy to .env. No real administrator is created by seed.
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
SERVER_NAME="Your Minecraft Network"
SERVER_IP="play.example.com"
SERVER_PORT="25565"
SERVER_VERSION="1.8 - 1.21.x"
DISCORD_INVITE="https://discord.gg/example"
DISCORD_GUILD_ID=""
STORE_URL="/store"
LANGUAGE="vi"
THEME="dark"
# Set false after entering a real Minecraft host in /admin.
DEMO_MODE="true"
# Only enable on a trusted internal network for your configured Minecraft host.
ALLOW_PRIVATE_MC_HOST="false"
# Enable only behind a proxy that overwrites X-Forwarded-For (not appends untrusted values).
TRUST_PROXY="false"
# Optional bearer token >=32 characters for /api/stats/ingest. Never NEXT_PUBLIC_.
STATS_INGEST_TOKEN=""
# One-time admin provisioning, remove from runtime after use. No defaults.
ADMIN_EMAIL=""
ADMIN_NAME="Administrator"
ADMIN_PASSWORD=""
ADMIN_ROLE="ADMIN"

# Optional origin for a separate static iNET frontend. Exact HTTPS origin, no trailing slash.
STATIC_SITE_ORIGIN=""
INET_SITE_URL="https://ryuuworl.id.vn"
# Set true only for the first demo bootstrap, then disable.
SEED_DEMO_ON_BOOT="false"

# sqlite for local development, postgres for a fresh PostgreSQL deployment.
DB_PROVIDER="sqlite"
